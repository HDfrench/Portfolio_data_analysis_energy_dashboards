    <dashboard enable-sort-zone-taborder='true' name='dbd_pcap_usg'>
      <style />
      <size maxheight='900' maxwidth='1600' minheight='900' minwidth='1600' preset-index='8' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Energy_Data_1990_2025+ (Energy_Data_1990_2025)' name='federated.1nxl9po1rpxyin1abjqk70mqi4hw' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='p_en_1_Visualisation' datatype='string' name='[Parameter 1201822960754689]' param-domain-type='list' role='measure' type='nominal' value='&quot;Group(s)&quot;'>
          <calculation class='tableau' formula='&quot;Group(s)&quot;' />
          <members>
            <member value='&quot;Total&quot;' />
            <member value='&quot;Group(s)&quot;' />
            <member value='&quot;Item(s)&quot;' />
          </members>
        </column>
        <column caption='p_ct_1_Visualisation' datatype='string' name='[Parameter 1201822963638285]' param-domain-type='list' role='measure' type='nominal' value='&quot;Group(s)&quot;'>
          <calculation class='tableau' formula='&quot;Group(s)&quot;' />
          <members>
            <member value='&quot;World&quot;' />
            <member value='&quot;Group(s)&quot;' />
            <member value='&quot;Country/-ies&quot;' />
          </members>
        </column>
        <column caption='p_ct_2_Regional division' datatype='string' name='[Parameter 1201822963793935]' param-domain-type='list' role='measure' type='nominal' value='&quot;Continent&quot;'>
          <calculation class='tableau' formula='&quot;Continent&quot;' />
          <members>
            <member value='&quot;Continent&quot;' />
            <member value='&quot;Ember region&quot;' />
          </members>
        </column>
        <column caption='nav_3_title_pcap_usg' datatype='string' name='[nav_3_focus_2_gen (copy)_1201822969413685]' param-domain-type='list' role='measure' type='nominal' value='&quot;Map&quot;'>
          <calculation class='tableau' formula='&quot;Map&quot;' />
          <members>
            <member value='&quot;kWh per capita per energy type(s)&quot;' />
            <member value='&quot;kWh per capita per regional distribution&quot;' />
            <member value='&quot;Year on Year variations&quot;' />
            <member value='&quot;Map&quot;' />
          </members>
        </column>
        <column caption='p_ct_3_Select_Grouping' datatype='string' name='[p_ct_2_Regional division (copy)_1201822964699155]' param-domain-type='list' role='measure' type='nominal' value='&quot;Membership&quot;'>
          <calculation class='tableau' formula='&quot;Membership&quot;' />
          <members>
            <member value='&quot;Region&quot;' />
            <member value='&quot;Income&quot;' />
            <member value='&quot;Membership&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1nxl9po1rpxyin1abjqk70mqi4hw'>
        <column caption='en_2_Group' datatype='string' name='[Calculation_1201822961688580]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Type] IN (&apos;Coal&apos;,&apos;Oil&apos;,&apos;Gas&apos;) THEN &#13;&#10;    &apos;Fossil fuels&apos; &#13;&#10;ELSEIF [Type] = &apos;Nuclear&apos; &#13;&#10;    THEN &apos;Nuclear&apos; &#13;&#10;ELSE &apos;Renewables&apos; &#13;&#10;END' />
        </column>
        <column caption='ct_1_Show_Region' datatype='string' name='[Calculation_1201822964072464]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 1201822963793935] = &quot;Continent&quot; THEN &#13;&#10;    [Continent] &#13;&#10;ELSE [Ember region] &#13;&#10;END' />
        </column>
        <column caption='nav_title_pcap_usg' datatype='string' name='[Calculation_1201822968266796]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Calculation_1201822969929783]&#13;&#10;    // pcap usage&#13;&#10;    WHEN 6 THEN &quot;Energy usage per capita (kWh/person) over time — per energy type&quot;&#13;&#10;    WHEN 7 THEN &quot;Energy usage per capita (kWh/person)  — per country/region&quot;&#13;&#10;    WHEN 8 THEN &quot;Energy usage per capita, year on year changes (% and kWh) — per energy type&quot;&#13;&#10;    WHEN 9 THEN &quot;Energy usage per capita (kWh per person) over time&quot;&#13;&#10;END' />
        </column>
        <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column datatype='string' name='[Income]' role='dimension' type='nominal' />
        <column caption='Type_usg' datatype='string' name='[Type_gen (copy)_1201822962208775]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF NOT [Source] THEN &#13;&#10;    [Type] &#13;&#10;END' />
        </column>
        <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
        <column-instance column='[Calculation_1201822961688580]' derivation='None' name='[none:Calculation_1201822961688580:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_1201822964072464]' derivation='None' name='[none:Calculation_1201822964072464:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_1201822968266796]' derivation='None' name='[none:Calculation_1201822968266796:nk]' pivot='key' type='nominal' />
        <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
        <column-instance column='[Income]' derivation='None' name='[none:Income:nk]' pivot='key' type='nominal' />
        <column-instance column='[Type_gen (copy)_1201822962208775]' derivation='None' name='[none:Type_gen (copy)_1201822962208775:nk]' pivot='key' type='nominal' />
        <column-instance column='[Year]' derivation='None' name='[none:Year:ok]' pivot='key' type='ordinal' />
      </datasource-dependencies>

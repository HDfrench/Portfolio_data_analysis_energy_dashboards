          <calculation class='tableau' formula='&quot;Map&quot;' />
          <members>
            <member value='&quot;TWh per energy type(s)&quot;' />
            <member value='&quot;TWh per regional distribution&quot;' />
            <member value='&quot;Global percentage share&quot;' />

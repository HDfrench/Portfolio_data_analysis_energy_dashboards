            <column caption='Real Pop' datatype='integer' name='[real_pop]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1201822970183737]' derivation='User' name='[usr:Calculation_1201822970183737:qk]' pivot='key' type='quantitative' />

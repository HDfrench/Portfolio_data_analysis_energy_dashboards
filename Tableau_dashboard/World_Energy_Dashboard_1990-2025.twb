            <column-instance column='[Calculation_1201822974337112]' derivation='None' name='[none:Calculation_1201822974337112:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />

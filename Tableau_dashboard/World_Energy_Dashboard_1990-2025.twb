            <column-instance column='[Calculation_1201822970404923]' derivation='User' name='[usr:Calculation_1201822970404923:qk]' pivot='key' type='quantitative' />
            <column caption='value_usg' datatype='real' name='[value_gen (copy)_1201822962413577]' role='measure' type='quantitative'>

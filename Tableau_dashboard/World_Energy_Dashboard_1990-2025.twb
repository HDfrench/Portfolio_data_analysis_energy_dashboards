            <column-instance column='[Calculation_1201822973251664]' derivation='User' name='[usr:Calculation_1201822973251664:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.1nxl9po1rpxyin1abjqk70mqi4hw].[Calculation_1201822972026948]' ordering-type='Rows' />
            </column-instance>

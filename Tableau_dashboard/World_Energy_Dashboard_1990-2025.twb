            <column-instance column='[Calculation_1201822962114566]' derivation='None' name='[none:Calculation_1201822962114566:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1201822964072464]' derivation='None' name='[none:Calculation_1201822964072464:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1201822966128667]' derivation='None' name='[none:Calculation_1201822966128667:nk]' pivot='key' type='nominal' />

    <worksheet name='BL_YoY_%_Type_pcap_usg'>
      <table>
        <view>
          <datasources>
            <datasource caption='Energy_Data_1990_2025+ (Energy_Data_1990_2025)' name='federated.1nxl9po1rpxyin1abjqk70mqi4hw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_en_1_Visualisation' datatype='string' name='[Parameter 1201822960754689]' param-domain-type='list' role='measure' type='nominal' value='&quot;Group(s)&quot;'>
              <calculation class='tableau' formula='&quot;Group(s)&quot;' />
            </column>
            <column caption='p_ct_2_Regional division' datatype='string' name='[Parameter 1201822963793935]' param-domain-type='list' role='measure' type='nominal' value='&quot;Continent&quot;'>
              <calculation class='tableau' formula='&quot;Continent&quot;' />
            </column>
            <column caption='nav_3_title_pcap_usg' datatype='string' name='[nav_3_focus_2_gen (copy)_1201822969413685]' param-domain-type='list' role='measure' type='nominal' value='&quot;Map&quot;'>
              <calculation class='tableau' formula='&quot;Map&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nxl9po1rpxyin1abjqk70mqi4hw'>
            <column caption='Asean' datatype='boolean' name='[ASEAN]' role='dimension' type='nominal' />
            <column caption='en_1_Display_usg' datatype='string' name='[Calculation_1201822961479683]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1201822960754689] = &quot;Total&quot; THEN &#13;&#10;    &quot;Total energy&quot; &#13;&#10;ELSEIF [Parameters].[Parameter 1201822960754689] = &quot;Group(s)&quot; THEN &#13;&#10;    [Calculation_1201822961688580] &#13;&#10;ELSEIF [Parameters].[Parameter 1201822960754689] = &quot;Item(s)&quot; THEN &#13;&#10;    [Type_gen (copy)_1201822962208775] &#13;&#10;END' />
            </column>
            <column caption='en_2_Group' datatype='string' name='[Calculation_1201822961688580]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Type] IN (&apos;Coal&apos;,&apos;Oil&apos;,&apos;Gas&apos;) THEN &#13;&#10;    &apos;Fossil fuels&apos; &#13;&#10;ELSEIF [Type] = &apos;Nuclear&apos; &#13;&#10;    THEN &apos;Nuclear&apos; &#13;&#10;ELSE &apos;Renewables&apos; &#13;&#10;END' />
            </column>
            <column caption='en_3_IsAvailable' datatype='boolean' name='[Calculation_1201822961938437]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Source] THEN &#13;&#10;    NOT ([Type] IN (&quot;Biofuels&quot;, &quot;Other renewables&quot;))&#13;&#10;ELSE &#13;&#10;    NOT ([Type] IN (&quot;Bioenergy&quot;, &quot;Other renewables excluding bioenergy&quot;)) &#13;&#10;END' />
            </column>
            <column caption='ct_1_Show_Region' datatype='string' name='[Calculation_1201822964072464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1201822963793935] = &quot;Continent&quot; THEN &#13;&#10;    [Continent] &#13;&#10;ELSE [Ember region] &#13;&#10;END' />
            </column>
            <column caption='nav_BL_pcap_usg' datatype='boolean' name='[Calculation_1201822966255644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// 100 = Usage&#13;&#10;// 20  = per capita&#13;&#10;// 8   = Year on year variations&#13;&#10;&#13;&#10;IF [Calculation_1201822969929783] = 8 THEN &#13;&#10;    TRUE &#13;&#10;ELSE &#13;&#10;    FALSE &#13;&#10;END' />
            </column>
            <column caption='nav_title_pcap_usg' datatype='string' name='[Calculation_1201822968266796]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_1201822969929783]&#13;&#10;    // pcap usage&#13;&#10;    WHEN 6 THEN &quot;Energy usage per capita (kWh/person) over time — per energy type&quot;&#13;&#10;    WHEN 7 THEN &quot;Energy usage per capita (kWh/person)  — per country/region&quot;&#13;&#10;    WHEN 8 THEN &quot;Energy usage per capita, year on year changes (% and kWh) — per energy type&quot;&#13;&#10;    WHEN 9 THEN &quot;Energy usage per capita (kWh per person) over time&quot;&#13;&#10;END' />
            </column>
            <column caption='nav_wk_pcap_usg' datatype='integer' name='[Calculation_1201822969929783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[nav_3_focus_2_gen (copy)_1201822969413685] = &quot;kWh per capita per energy type(s)&quot; THEN&#13;&#10;    6&#13;&#10;ELSEIF [Parameters].[nav_3_focus_2_gen (copy)_1201822969413685] = &quot;kWh per capita per regional distribution&quot; THEN &#13;&#10;    7&#13;&#10;ELSEIF [Parameters].[nav_3_focus_2_gen (copy)_1201822969413685] = &quot;Year on Year variations&quot; THEN &#13;&#10;    8&#13;&#10;ELSE &#13;&#10;    9  // Map&#13;&#10;END' />
            </column>
            <column caption='pcap_usg' datatype='real' name='[Calculation_1201822970294330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[value_gen (copy)_1201822962413577] / [Calculation_1964609981091843] * 1E9' />
            </column>
            <column caption='prev_pcap_usg' datatype='real' name='[Calculation_1201822972133445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM([Calculation_1201822970294330], -1, -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='yoy_pct_pcap_usg' datatype='real' name='[Calculation_1201822973415506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1201822973501523] / [Calculation_1201822972133445]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='yoy_pcap_usg' datatype='real' name='[Calculation_1201822973501523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1201822970294330] - [Calculation_1201822972133445]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='ct_4_Membership' datatype='string' name='[Calculation_1201822974095447]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [ASEAN] THEN &quot;ASEAN&quot;&#13;&#10;ELSEIF [EU] THEN &quot;EU&quot;&#13;&#10;ELSEIF [G7] THEN &quot;G7&quot;&#13;&#10;ELSEIF [G20] THEN &quot;G20&quot;&#13;&#10;ELSEIF [OECD] THEN &quot;OECD&quot;&#13;&#10;ELSE &quot;None&quot;&#13;&#10;END' />
            </column>
            <column caption='ct_4_show_mbsp' datatype='boolean' name='[Calculation_1201822974337112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='( [ASEAN] AND [f_1_membership_set] )&#13;&#10;OR&#13;&#10;( [EU] AND [f_1_membership_set] )&#13;&#10;OR&#13;&#10;( [G7] AND [f_1_membership_set] )&#13;&#10;OR&#13;&#10;( [G20] AND [f_1_membership_set] )&#13;&#10;OR&#13;&#10;( [OECD] AND [f_1_membership_set] )&#13;&#10;OR&#13;&#10;( NOT ( [ASEAN] OR [EU] OR [G7] OR [G20] OR [OECD] )&#13;&#10;    AND [f_1_membership_set]&#13;&#10;)' />
            </column>
            <column caption='pcap_agg' datatype='integer' name='[Calculation_1964609981091843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([real_pop])' />
            </column>
